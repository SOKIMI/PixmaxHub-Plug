{
  "manifest_version": 3,
  "name": "PixmaxHub Plug",
  "version": "2.0.37",
  "description": "Add Pixmax and Jimeng collection helpers, Eagle import, and a shared team review board.",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://app.pixmax.cn/*",
    "https://jimeng.jianying.com/*",
    "https://*.jianying.com/*",
    "https://*.jimeng.com/*",
    "https://*.vlabvod.com/*",
    "https://*.vlabstatic.com/*",
    "https://*.byteimg.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.bytecdn.com/*",
    "https://*.volces.com/*",
    "https://*.volccdn.com/*",
    "https://*.aliyuncs.com/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://raw.githubusercontent.com/*",
    "http://localhost:41595/*",
    "http://127.0.0.1:41595/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.pixmax.cn/*"
      ],
      "js": [
        "project-scopes.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.pixmax.cn/*"
      ],
      "js": [
        "relay.js",
        "project-scopes.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jimeng.jianying.com/*"
      ],
      "js": [
        "jimeng-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://jimeng.jianying.com/*"
      ],
      "js": [
        "jimeng.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PixmaxHub Plug"
  }
}
